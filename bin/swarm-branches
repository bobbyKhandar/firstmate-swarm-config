#!/usr/bin/env python3
"""Plan, check, and stage the branches of one swarm task.

A swarm task has one integration branch <prefix><name> and workers
<name>-worker-1..N on branches <prefix><name>-worker-N. Those GitHub branches
are the saved copy of the work. Workers may edit the same file. owns records
where a worker expects to work; it is not an exclusive lock.

  init PLAN --project OWNER/REPO --name NAME --workers N [--prefix P] [--base B]
  check PLAN
  boundary PLAN WORKER (--repo CLONE [--no-fetch] | --files FILE)
  overlap PLAN --repo CLONE [--no-fetch]
  conflicts PLAN --repo CLONE [--no-fetch]
  reconcile PLAN --repo CLONE
  create-integration PLAN
"""
import argparse
import json
import os
import tempfile
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys

TASK_ID = re.compile(r"[A-Za-z0-9._-]{1,64}")
PROJECT = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
WORKER_SUFFIX = re.compile(r"-worker-([1-9][0-9]*)")


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def load(path):
    try:
        return json.loads(Path(path).read_text())
    except FileNotFoundError:
        fail(f"plan not found: {path}")
    except ValueError as error:
        fail(f"plan is not valid JSON: {path}: {error}")


def prefix(plan):
    return plan.get("branch_prefix", "")


def integration(plan):
    return prefix(plan) + plan["name"]


def branch(plan, worker_id):
    return prefix(plan) + worker_id


def valid_ref(name):
    return subprocess.run(
        ["git", "check-ref-format", "--branch", name], capture_output=True,
    ).returncode == 0


def normalize(entry):
    if not isinstance(entry, str) or not entry.strip():
        return None, "must be a non-empty string"
    if any(char in entry for char in "*?["):
        return None, "globs are not supported; list files or directories"
    path = PurePosixPath(entry)
    if path.is_absolute() or ".." in path.parts:
        return None, "must be relative to the repository root without '..'"
    parts = [part for part in path.parts if part != "."]
    if not parts:
        return None, "must name a file or directory below the repository root"
    return "/".join(parts), None


def covers(owned, changed):
    return changed == owned or changed.startswith(owned + "/")


def overlaps(first, second):
    return covers(first, second) or covers(second, first)


def worker_number(worker_id):
    match = WORKER_SUFFIX.search(worker_id)
    return int(match.group(1)) if match else 0


def validate_names(plan, problems):
    name = plan.get("name")
    if not isinstance(name, str) or not TASK_ID.fullmatch(name) or len(name) > 54:
        problems.append("name must be 1-54 characters of letters, digits, '.', '_' or '-'")
        return False
    if not isinstance(plan.get("project"), str) or not PROJECT.fullmatch(plan["project"]):
        problems.append("project must be OWNER/REPO")
    base = plan.get("base")
    if not isinstance(base, str) or not valid_ref(base):
        problems.append("base must be a valid branch name")
    branch_prefix = prefix(plan)
    if not isinstance(branch_prefix, str) or " " in branch_prefix or branch_prefix.startswith("-"):
        problems.append("branch_prefix must be a string without spaces that does not start with '-'")
        return False
    if not valid_ref(integration(plan)):
        problems.append(f"integration branch is not a valid branch name: {integration(plan)}")
    if base == integration(plan):
        problems.append("the integration branch must differ from base")
    return True


def worker_ids(plan):
    return [worker.get("id") for worker in plan.get("workers", []) if isinstance(worker, dict)]


def validate(plan):
    problems = []
    if not isinstance(plan, dict):
        return ["plan must be a JSON object"], []
    if not validate_names(plan, problems):
        return problems, []
    workers = plan.get("workers")
    if not isinstance(workers, list) or not workers:
        return problems + ["workers must be a non-empty list"], []

    ids = worker_ids(plan)
    owned = {}
    for index, worker in enumerate(workers, 1):
        if not isinstance(worker, dict):
            problems.append(f"worker {index} must be an object")
            continue
        worker_id = worker.get("id")
        expected = re.compile(re.escape(plan["name"]) + WORKER_SUFFIX.pattern)
        if not isinstance(worker_id, str) or not expected.fullmatch(worker_id):
            problems.append(f"worker {index} id must be {plan['name']}-worker-<n>")
            continue
        if not TASK_ID.fullmatch(worker_id):
            problems.append(f"{worker_id}: task ids are limited to 64 characters")
        if ids.count(worker_id) > 1:
            problems.append(f"duplicate worker id: {worker_id}")
        if not valid_ref(branch(plan, worker_id)):
            problems.append(f"{worker_id}: branch is not a valid branch name: {branch(plan, worker_id)}")
        paths = worker.get("owns", [])
        if not isinstance(paths, list):
            problems.append(f"{worker_id}: owns must be a list of files or directories, or empty")
            paths = []
        normalized = []
        for entry in paths:
            path, error = normalize(entry)
            if error:
                problems.append(f"{worker_id}: owned path {entry!r} {error}")
            else:
                normalized.append(path)
        owned[worker_id] = sorted(set(normalized))
        dependencies = worker.get("depends_on", [])
        if not isinstance(dependencies, list):
            problems.append(f"{worker_id}: depends_on must be a list of worker ids")
            continue
        for dependency in dependencies:
            if dependency == worker_id:
                problems.append(f"{worker_id}: cannot depend on itself")
            elif dependency not in ids:
                problems.append(f"{worker_id}: depends on unknown worker {dependency!r}")

    if problems:
        return problems, []

    remaining = {worker["id"]: set(worker.get("depends_on", [])) for worker in workers}
    order = []
    while remaining:
        ready = sorted((worker_id for worker_id, deps in remaining.items() if not deps), key=worker_number)
        if not ready:
            cycle = ", ".join(sorted(remaining, key=worker_number))
            return [f"dependency cycle among: {cycle}"], []
        for worker_id in ready:
            order.append(worker_id)
            del remaining[worker_id]
        for deps in remaining.values():
            deps.difference_update(ready)
    return [], order


def require_valid(plan):
    problems, order = validate(plan)
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        fail("plan is invalid")
    return order


def worker_entry(plan, worker_id):
    for worker in plan["workers"]:
        if worker["id"] == worker_id:
            return worker
    fail(f"unknown worker {worker_id!r}; known: {', '.join(worker_ids(plan))}")


def owned_paths(worker):
    return [normalize(entry)[0] for entry in worker.get("owns") or []]


def shared_claims(plan):
    claims = []
    workers = [worker for worker in plan["workers"] if isinstance(worker, dict) and worker.get("id")]
    for position, first in enumerate(workers):
        for second in workers[position + 1:]:
            for left in owned_paths(first):
                for right in owned_paths(second):
                    if overlaps(left, right):
                        claims.append((left, right, first["id"], second["id"]))
    return claims


def git(repo, *args, identity=False, raw=False):
    command = ["git", "--literal-pathspecs", "-C", repo]
    if identity:
        command += ["-c", "user.email=swarm-conflicts@localhost", "-c", "user.name=swarm-conflicts"]
    return subprocess.run([*command, *args], capture_output=True, text=not raw,
                          **({} if raw else {"errors": "replace"}))


def display(path):
    return json.dumps(path, ensure_ascii=False) if any(ord(c) < 32 or c in '\"\\' for c in path) else path


def conflicted_paths(output):
    # -z: tree OID, conflicted names, empty record, then structured messages.
    fields = output.split(b"\0")[1:]
    paths = []
    for field in fields:
        if not field:
            break
        paths.append(os.fsdecode(field))
    return paths


def ancestor(repo, head, base):
    result = git(repo, "merge-base", "--is-ancestor", head, base)
    if result.returncode not in (0, 1):
        fail(f"could not verify ancestry of {head}: {result.stderr.strip()}")
    return result.returncode == 0


def pending_workers(plan, repo, order, present):
    pending = []
    target = f"origin/{integration(plan)}"
    for worker_id in order:
        head = branch(plan, worker_id)
        record = worker_entry(plan, worker_id).get("landed")
        if record is not None:
            if (not isinstance(record, dict)
                    or set(record) != {"pr_url", "head_sha", "merge_commit_sha"}
                    or not re.fullmatch(r"https://github.com/" + re.escape(plan["project"]) + r"/pull/[1-9][0-9]*", str(record.get("pr_url")))
                    or any(not re.fullmatch(r"[0-9a-f]{40}", str(record.get(key)))
                           for key in ("head_sha", "merge_commit_sha"))):
                fail(f"invalid landed record for {worker_id}; reconcile the plan")
            if not ancestor(repo, record["merge_commit_sha"], target):
                fail(f"stale landed record for {worker_id}: merge commit is not in integration")
            if head in present and git(repo, "rev-parse", f"origin/{head}").stdout.strip() != record["head_sha"]:
                fail(f"landed head changed for {worker_id}; review and reconcile before proceeding")
            continue
        if head not in present:
            fail(f"missing worker branch {head}; completion cannot be verified")
        if not ancestor(repo, f"origin/{head}", target):
            pending.append(worker_id)
    return pending


def remote_branches(repo, names, fetch):
    if not fetch:
        return [name for name in names
                if git(repo, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{name}").returncode == 0]
    present = []
    for name in names:
        listed = git(repo, "ls-remote", "--exit-code", "origin", f"refs/heads/{name}")
        if listed.returncode == 0:
            present.append(name)
        elif listed.returncode != 2:
            fail(f"could not read origin in {repo}: {listed.stderr.strip()}")
    if present:
        refspecs = [f"+refs/heads/{name}:refs/remotes/origin/{name}" for name in present]
        fetched = git(repo, "fetch", "--quiet", "origin", *refspecs)
        if fetched.returncode:
            fail(f"git fetch failed in {repo}: {fetched.stderr.strip()}")
    return present


def changed_files(repo, base_branch, head_branch):
    diff = git(repo, "diff", "--name-only", "--no-renames", "-z",
               f"origin/{base_branch}...origin/{head_branch}", raw=True)
    if diff.returncode:
        fail(f"could not diff {head_branch} against {base_branch}: {os.fsdecode(diff.stderr).strip()}")
    return [os.fsdecode(name) for name in diff.stdout.split(b"\0") if name]


def owner_of(plan, path):
    for worker in plan["workers"]:
        if any(covers(owned, path) for owned in owned_paths(worker)):
            return worker["id"]
    return None


def cmd_init(args):
    path = Path(args.plan)
    if path.exists():
        fail(f"plan already exists: {path}")
    if args.workers < 1:
        fail("--workers must be at least 1")
    plan = {
        "project": args.project,
        "name": args.name,
        "base": args.base,
        "branch_prefix": args.prefix,
        "workers": [
            {"id": f"{args.name}-worker-{number}", "owns": [], "depends_on": []}
            for number in range(1, args.workers + 1)
        ],
    }
    problems = []
    validate_names(plan, problems)
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        fail("cannot create plan")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(plan, indent=2) + "\n")
    print(f"Created {path}: integration {integration(plan)}, workers "
          f"{', '.join(branch(plan, worker_id) for worker_id in worker_ids(plan))}.")
    print("Record where each worker expects to work. Shared paths are allowed. "
          "Then run: swarm-branches check " + str(path))


def cmd_check(args):
    plan = load(args.plan)
    order = require_valid(plan)
    print(f"Integration branch {integration(plan)} from {plan['base']} in {plan['project']}.")
    print("Merge order:")
    for position, worker_id in enumerate(order, 1):
        worker = worker_entry(plan, worker_id)
        owned = owned_paths(worker)
        line = f"  {position}. {worker_id} on {branch(plan, worker_id)} works in {', '.join(owned) if owned else 'any path'}"
        if worker.get("depends_on"):
            line += f"; after {', '.join(worker['depends_on'])}"
        print(line)
    claims = shared_claims(plan)
    if claims:
        print("Shared paths (workers may edit these; a conflict helper resolves real merge conflicts):")
        for left, right, first, second in claims:
            same = left if left == right else f"{left} and {right}"
            print(f"  {same}: {first}, {second}")
    print("Plan valid. Saved work is the GitHub branch, not a checkout on the PC.")


def cmd_boundary(args):
    plan = load(args.plan)
    require_valid(plan)
    worker = worker_entry(plan, args.worker)
    if args.files:
        text = sys.stdin.read() if args.files == "-" else Path(args.files).read_text()
        files = [line.strip() for line in text.splitlines() if line.strip()]
    else:
        head = branch(plan, args.worker)
        present = remote_branches(args.repo, [integration(plan), head], not args.no_fetch)
        for name in (integration(plan), head):
            if name not in present:
                fail(f"branch {name} is not on origin yet")
        files = changed_files(args.repo, integration(plan), head)
    mine = owned_paths(worker)
    if not mine:
        print(f"{args.worker} has no declared paths; it may edit any file. Changed paths checked: {len(files)}.")
        return
    outside = [path for path in files if not any(covers(owned, path) for owned in mine)]
    if not outside:
        print(f"{args.worker} stayed within its boundary; changed paths checked: {len(files)}.")
        return
    print(f"{args.worker} changed {len(outside)} paths outside its boundary:")
    for path in outside:
        owner = owner_of(plan, path)
        print(f"  {display(path)} (owned by {owner})" if owner else f"  {display(path)} (owned by no worker)")
    sys.exit(1)


def cmd_overlap(args):
    plan = load(args.plan)
    order = require_valid(plan)
    heads = [branch(plan, worker_id) for worker_id in order]
    present = remote_branches(args.repo, [integration(plan), *heads], not args.no_fetch)
    if integration(plan) not in present:
        fail(f"branch {integration(plan)} is not on origin yet")
    pending = pending_workers(plan, args.repo, order, present)
    touched = {}
    for worker_id in pending:
        head = branch(plan, worker_id)
        for path in changed_files(args.repo, integration(plan), head):
            touched.setdefault(path, []).append(worker_id)
    shared = {path: ids for path, ids in sorted(touched.items()) if len(ids) > 1}
    if not shared:
        print("No file is changed by more than one open worker branch.")
        return
    print("Files changed by more than one open worker branch:")
    for path, ids in shared.items():
        print(f"  {display(path)}: {', '.join(ids)}")
    print("Shared edits are allowed. Run: swarm-branches conflicts " + args.plan)


def cmd_conflicts(args):
    """Report a real merge conflict, with every worker's edit of those files.

    Uses git merge-tree, so it does not check out the project. It may write a
    dangling commit in the clone while it stacks clean merges; it does not
    move any branch.
    """
    plan = load(args.plan)
    order = require_valid(plan)
    heads = [branch(plan, worker_id) for worker_id in order]
    present = remote_branches(args.repo, [integration(plan), *heads], not args.no_fetch)
    if integration(plan) not in present:
        fail(f"branch {integration(plan)} is not on origin yet")
    pending = pending_workers(plan, args.repo, order, present)
    current = git(args.repo, "rev-parse", f"origin/{integration(plan)}").stdout.strip()
    clean = []
    for worker_id in pending:
        head = branch(plan, worker_id)
        head_sha = git(args.repo, "rev-parse", f"origin/{head}").stdout.strip()
        merged = git(args.repo, "merge-tree", "--write-tree", "--name-only", "-z",
                     current, head_sha, raw=True)
        if merged.returncode == 0:
            tree = os.fsdecode(merged.stdout.split(b"\0", 1)[0]).strip()
            made = git(args.repo, "commit-tree", tree, "-p", current, "-p", head_sha,
                       "-m", f"swarm-conflicts {worker_id}", identity=True)
            if made.returncode or not re.fullmatch(r"[0-9a-f]{40}", made.stdout.strip()):
                fail(f"could not stack a clean merge of {head}: {made.stderr.strip()}")
            current = made.stdout.strip()
            clean.append(worker_id)
            continue
        if merged.returncode != 1:
            fail(f"could not try merging {head}: {os.fsdecode(merged.stderr).strip()}")
        print(f"Conflict merging {head} ({head_sha}) into the integration result:")
        if clean:
            print("Merge this clean prefix first, then refresh this report: " + ", ".join(clean))
        paths = conflicted_paths(merged.stdout)
        if not paths:
            print("Conflict has no individual file entries; inspect the complete merge-tree diagnostics:")
            print(os.fsdecode(merged.stdout).replace("\0", "\n"))
        for path in paths:
            print(f"  {display(path)}")
        # Include full side patches: a conflict can be reported under a renamed
        # destination while another contributor edited the original pathname.
        # Restricting patches to reported names loses that contributor's intent.
        for editor, revision in [("integration", f"origin/{integration(plan)}"),
                                 *[(e, f"origin/{branch(plan, e)}") for e in pending]]:
            against = head_sha if editor == "integration" else f"origin/{integration(plan)}"
            base = git(args.repo, "merge-base", revision, against)
            if base.returncode:
                fail(f"could not find merge base for {editor}: {base.stderr.strip()}")
            diff = git(args.repo, "diff", "--binary", "--find-renames", "--no-ext-diff", "--no-textconv",
                       "--unified=3", base.stdout.strip(), revision)
            if diff.returncode:
                fail(f"could not inspect {editor}: {diff.stderr.strip()}")
            print(f"--- {editor} changed {', '.join(display(path) for path in paths)}; "
                  "complete side diff relative to its merge base ---")
            print(diff.stdout.rstrip() or "(no changes on this side relative to its merge base)")
        if args.no_fetch:
            names = git(args.repo, "for-each-ref", "--format=%(refname:strip=3)", "refs/remotes/origin/").stdout.splitlines()
        else:
            listed = git(args.repo, "ls-remote", "--heads", "origin")
            if listed.returncode:
                fail(f"could not allocate a resolution name: {listed.stderr.strip()}")
            names = [line.split("refs/heads/", 1)[1] for line in listed.stdout.splitlines()]
        number = 1
        while f"{integration(plan)}-resolve-{number}" in names:
            number += 1
        resolve = f"{integration(plan)}-resolve-{number}"
        print(f"After merging the clean prefix and refreshing, dispatch the conflict helper. "
              f"Start {resolve} from current integration, merge reviewed head {head_sha}, "
              f"resolve every side, and preserve both parents. Open its PR into {integration(plan)}. "
              "Recheck the branch name is unused before pushing; --no-fetch only knows local refs.")
        sys.exit(1)
    if pending:
        print("No merge conflicts. Worker branches can merge into the integration branch in order.")
    else:
        print("All worker revisions accounted for in integration. Run integration checks before delivery.")


def gh(*args):
    return subprocess.run(["gh", *args], capture_output=True, text=True)


def cmd_reconcile(args):
    plan = load(args.plan)
    order = require_valid(plan)
    allowed = {f"https://github.com/{plan['project']}", f"https://github.com/{plan['project']}.git",
               f"git@github.com:{plan['project']}.git", f"ssh://git@github.com/{plan['project']}.git"}
    # Read configured URL, before Git's insteadOf transport rewrites.
    remote = git(args.repo, "config", "--get", "remote.origin.url").stdout.strip()
    if remote.lower() not in {url.lower() for url in allowed}:
        fail("origin does not match the planned GitHub repository")
    heads = [branch(plan, worker_id) for worker_id in order]
    present = remote_branches(args.repo, [integration(plan), *heads], True)
    if integration(plan) not in present:
        fail("integration branch is missing on origin")
    prs = []
    page = 1
    while True:
        result = gh("api", f"repos/{plan['project']}/pulls?state=closed&per_page=100&page={page}")
        if result.returncode:
            fail("GitHub PR data unavailable; plan unchanged")
        try:
            batch = json.loads(result.stdout)
            if not isinstance(batch, list):
                raise ValueError("expected a PR list")
        except ValueError:
            fail("invalid GitHub PR response; plan unchanged")
        prs.extend(batch)
        if len(batch) < 100:
            break
        page += 1
    for worker_id, head in zip(order, heads):
        matches = [pr for pr in prs if pr.get("head", {}).get("ref") == head and pr.get("merged_at")]
        if not matches:
            if worker_entry(plan, worker_id).get("landed") is not None:
                fail(f"could not reverify landed PR for {head}; plan unchanged")
            continue
        if len(matches) != 1:
            fail(f"ambiguous merged PRs for {head}; plan unchanged")
        pr = matches[0]
        base, source = pr.get("base", {}), pr.get("head", {})
        if (base.get("ref") != integration(plan)
                or base.get("repo", {}).get("full_name", "").lower() != plan["project"].lower()
                or (source.get("repo") or {}).get("full_name", "").lower() != plan["project"].lower()):
            fail(f"merged PR repository/base mismatch for {head}; plan unchanged")
        sha, merge = source.get("sha", ""), pr.get("merge_commit_sha", "")
        url = pr.get("html_url", "")
        if (not all(re.fullmatch(r"[0-9a-f]{40}", value or "") for value in (sha, merge))
                or not re.fullmatch(r"https://github.com/" + re.escape(plan["project"]) + r"/pull/[1-9][0-9]*", url)):
            fail(f"invalid merged PR evidence for {head}; plan unchanged")
        if head in present and git(args.repo, "rev-parse", f"origin/{head}").stdout.strip() != sha:
            fail(f"merged PR head changed for {head}; plan unchanged")
        if not ancestor(args.repo, merge, f"origin/{integration(plan)}"):
            fail(f"merge commit for {head} is not in integration; plan unchanged")
        worker_entry(plan, worker_id)["landed"] = {"pr_url": url, "head_sha": sha, "merge_commit_sha": merge}
    pending = pending_workers(plan, args.repo, order, present)
    path = Path(args.plan)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
            temporary = Path(stream.name)
            json.dump(plan, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    print(f"Reconciled verified merge evidence; {len(pending)} worker revisions remain pending.")


def cmd_create_integration(args):
    plan = load(args.plan)
    require_valid(plan)
    project, target = plan["project"], integration(plan)
    existing = gh("api", f"repos/{project}/git/ref/heads/{target}", "--jq", ".object.sha")
    if existing.returncode == 0:
        fail(f"{target} already exists in {project} at {existing.stdout.strip()}; refusing to move it")
    base = gh("api", f"repos/{project}/git/ref/heads/{plan['base']}", "--jq", ".object.sha")
    sha = base.stdout.strip()
    if base.returncode or not re.fullmatch(r"[0-9a-f]{40}", sha):
        fail(f"could not read {plan['base']} in {project}: {base.stderr.strip() or base.stdout.strip()}")
    created = gh("api", "-X", "POST", f"repos/{project}/git/refs",
                 "-f", f"ref=refs/heads/{target}", "-f", f"sha={sha}")
    if created.returncode:
        fail(f"could not create {target} in {project}: {created.stderr.strip()}")
    print(f"Created {target} at {sha} from {plan['base']} in {project}.")


parser = argparse.ArgumentParser(
    prog="swarm-branches", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
)
commands = parser.add_subparsers(dest="command", required=True)

init = commands.add_parser("init", help="create a plan skeleton")
init.add_argument("plan")
init.add_argument("--project", required=True, help="OWNER/REPO on GitHub")
init.add_argument("--name", required=True, help="integration branch name without prefix")
init.add_argument("--workers", type=int, required=True)
init.add_argument("--prefix", default="", help="branch prefix; empty gives exactly NAME and NAME-worker-N")
init.add_argument("--base", default="main")
init.set_defaults(run=cmd_init)

check = commands.add_parser("check", help="validate names, ownership, and dependencies")
check.add_argument("plan")
check.set_defaults(run=cmd_check)

boundary = commands.add_parser("boundary", help="list a worker's changes outside its owned paths")
boundary.add_argument("plan")
boundary.add_argument("worker")
source = boundary.add_mutually_exclusive_group(required=True)
source.add_argument("--repo", help="local clone whose origin is the project")
source.add_argument("--files", help="newline-separated changed paths, or - for stdin")
boundary.add_argument("--no-fetch", action="store_true")
boundary.set_defaults(run=cmd_boundary)

overlap = commands.add_parser("overlap", help="list files changed by more than one worker branch")
overlap.add_argument("plan")
overlap.add_argument("--repo", required=True)
overlap.add_argument("--no-fetch", action="store_true")
overlap.set_defaults(run=cmd_overlap)

conflicts = commands.add_parser("conflicts", help="show merge conflicts and every worker's side")
conflicts.add_argument("plan")
conflicts.add_argument("--repo", required=True)
conflicts.add_argument("--no-fetch", action="store_true")
conflicts.set_defaults(run=cmd_conflicts)

reconcile = commands.add_parser("reconcile", help="verify legacy merged PRs and atomically record landed revisions")
reconcile.add_argument("plan")
reconcile.add_argument("--repo", required=True)
reconcile.set_defaults(run=cmd_reconcile)

create = commands.add_parser("create-integration", help="create the integration branch on GitHub from base")
create.add_argument("plan")
create.set_defaults(run=cmd_create_integration)

parsed = parser.parse_args()
parsed.run(parsed)
